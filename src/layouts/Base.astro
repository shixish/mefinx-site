---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, robots, content } = Astro.props;
const [settingsResult, menuResult, footerProductResult, footerCompanyResult, footerSupportResult] =
	await Promise.all([
		getSiteSettingsWithCacheHint(),
		getMenuWithCacheHint("primary"),
		getMenuWithCacheHint("footer_product"),
		getMenuWithCacheHint("footer_company"),
		getMenuWithCacheHint("footer_support"),
	]);

if (Astro.cache?.enabled) {
	for (const result of [
		settingsResult,
		menuResult,
		footerProductResult,
		footerCompanyResult,
		footerSupportResult,
	]) {
		Astro.cache.set(result.cacheHint);
	}
}

const settings = settingsResult.data;
const siteTitle = settings?.title || "mefinx";
const fullTitle = title ? (title.includes(siteTitle) ? title : `${title} — ${siteTitle}`) : siteTitle;
const siteDescription =
	settings?.tagline || "The personal CRM you talk to";
const siteLogo = settings.logo?.url ? settings.logo : null;
const menu = menuResult.data;
const footerProduct = footerProductResult.data;
const footerCompany = footerCompanyResult.data;
const footerSupport = footerSupportResult.data;

const footerColumns = [
	{ heading: "Product", menu: footerProduct },
	{ heading: "Legal", menu: footerCompany },
	{ heading: "More", menu: footerSupport },
].filter((col) => col.menu && col.menu.items.length > 0);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteDescription,
	canonical: canonical ?? `${Astro.url.origin}${Astro.url.pathname}`,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-body" preload />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href="/logo.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/logo192.png" />
		<meta name="theme-color" content="#07080a" />
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav">
				<a href="/" class="site-logo" aria-label={`${siteTitle} home`}>
					{siteLogo ? (
						<img
							src={siteLogo.url}
							alt={siteLogo.alt || siteTitle}
							width={siteLogo.width}
							height={siteLogo.height}
							class="site-logo-img"
						/>
					) : (
						<span class="site-brand">
							<img src="/logo.svg" alt="" width="30" height="30" class="site-mark" />
							<span>{siteTitle}</span>
						</span>
					)}
				</a>
				<div class="nav-links">
					{menu?.items.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
						>
							{item.label}
						</a>
					))}
				</div>
				<div class="nav-actions">
					{isLoggedIn && <a href="/_emdash/admin" class="nav-admin">Admin</a>}
					<a href="https://mefinx.app" class="btn btn-primary nav-cta">Open mefinx</a>
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-content">
				<div class="footer-brand">
					<span class="site-brand footer-logo">
						<img src="/logo.svg" alt="" width="26" height="26" class="site-mark" />
						<span>{siteTitle}</span>
					</span>
					<p class="footer-tagline">{siteDescription}</p>
				</div>
				<div class="footer-links">
					{footerColumns.map((col) => (
						<div class="footer-col">
							<h4>{col.heading}</h4>
							{col.menu!.items.map((item) => (
								<a
									href={item.url}
									target={item.target}
									rel={item.target ? "noopener noreferrer" : undefined}
								>
									{item.label}
								</a>
							))}
						</div>
					))}
				</div>
			</div>
			<div class="footer-bottom">
				<p>&copy; {`${year} ${siteTitle}`}</p>
				<p class="footer-powered">
					Built with <a href="https://emdashcms.com">EmDash</a> on Cloudflare
				</p>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			// Fade sections in as they scroll into view. Elements opt in with data-reveal; siblings
			// can stagger with a --reveal-index custom property.
			const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
			if ("IntersectionObserver" in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add("is-visible");
							observer.unobserve(entry.target);
						}
					},
					{ rootMargin: "0px 0px -10% 0px" },
				);
				targets.forEach((el) => observer.observe(el));
			} else {
				targets.forEach((el) => el.classList.add("is-visible"));
			}

			// Solidify the header once the page has scrolled.
			const header = document.querySelector(".site-header");
			const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
			onScroll();
			window.addEventListener("scroll", onScroll, { passive: true });
		</script>

		<style is:global>
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				html {
					scroll-behavior: smooth;
					scroll-padding-top: 80px;
				}

				@media (prefers-reduced-motion: reduce) {
					html {
						scroll-behavior: auto;
					}

					*,
					*::before,
					*::after {
						animation-duration: 0.01ms !important;
						animation-iteration-count: 1 !important;
						transition-duration: 0.01ms !important;
					}
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					min-height: 100vh;
					overflow-x: hidden;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: currentColor;
					text-decoration: none;
				}

				p a:not([class]),
				li a:not([class]) {
					color: var(--color-brand);
					text-decoration: underline;
					text-underline-offset: 2px;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					font-weight: var(--font-weight-heading);
					line-height: var(--leading-snug);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-size: var(--font-size-5xl);
				}
				h2 {
					font-size: var(--font-size-3xl);
				}
				h3 {
					font-size: var(--font-size-2xl);
				}
				h4 {
					font-size: var(--font-size-xl);
				}

				.container {
					max-width: var(--wide-width);
					margin: 0 auto;
					padding: 0 var(--spacing-lg);
				}

				.section {
					padding: var(--spacing-4xl) 0;
				}

				.section-header {
					text-align: center;
					max-width: var(--max-width);
					margin: 0 auto var(--spacing-3xl);
				}

				.section-headline {
					font-size: var(--font-size-3xl);
					font-weight: var(--font-weight-display);
				}

				.section-subheadline {
					margin-top: var(--spacing-md);
					font-size: var(--font-size-lg);
					color: var(--color-muted);
				}

				.icon-tile {
					width: 44px;
					height: 44px;
					display: flex;
					align-items: center;
					justify-content: center;
					flex-shrink: 0;
					font-size: 1.35rem;
					border-radius: var(--radius);
				}

				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: var(--spacing-sm);
					padding: var(--spacing-sm) var(--spacing-lg);
					font-family: inherit;
					font-size: var(--font-size-sm);
					font-weight: 650;
					border-radius: var(--radius-full);
					cursor: pointer;
					transition:
						background var(--transition-fast),
						transform var(--transition-fast),
						box-shadow var(--transition-base),
						border-color var(--transition-fast);
				}

				.btn:hover {
					transform: translateY(-1px);
				}

				.btn:active {
					transform: translateY(0);
				}

				.btn-primary {
					color: var(--color-on-brand);
					background: var(--gradient-brand-strong);
					border: none;
				}

				.btn-secondary {
					color: var(--color-text);
					background: transparent;
					border: 1px solid var(--color-border);
				}

				.btn-lg {
					padding: 0.85rem 1.6rem;
					font-size: var(--font-size-base);
				}
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				border-bottom: 1px solid transparent;
				transition:
					background var(--transition-base),
					border-color var(--transition-base);
			}

			.site-header.is-scrolled {
				background: rgb(7 8 10 / 0.72);
				backdrop-filter: saturate(160%) blur(14px);
				-webkit-backdrop-filter: saturate(160%) blur(14px);
				border-bottom-color: var(--color-border);
			}

			.nav {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-md) var(--spacing-lg);
				display: flex;
				align-items: center;
				gap: var(--spacing-xl);
			}

			.site-logo {
				font-size: var(--font-size-xl);
				font-weight: var(--font-weight-display);
				letter-spacing: -0.03em;
			}

			.site-logo-img {
				height: 40px;
				width: auto;
			}

			.site-brand {
				display: inline-flex;
				align-items: center;
				gap: 0.6rem;
			}

			.site-mark {
				width: 30px;
				height: 30px;
			}

			.nav-links {
				display: flex;
				gap: var(--spacing-xl);
				margin-left: auto;
			}

			.nav-links a {
				font-size: var(--font-size-sm);
				font-weight: 500;
				color: var(--color-muted);
				transition: color var(--transition-fast);
			}

			.nav-links a:hover {
				color: var(--color-text);
			}

			.nav-actions {
				display: flex;
				align-items: center;
				gap: var(--spacing-lg);
			}

			.nav-admin {
				font-size: var(--font-size-sm);
				color: var(--color-faint);
			}

			.nav-cta {
				padding: 0.5rem 1.1rem;
			}

			main {
				min-height: calc(100vh - 200px);
			}

			.site-footer {
				margin-top: var(--spacing-3xl);
				border-top: 1px solid var(--color-border);
				background: linear-gradient(180deg, transparent, rgb(255 255 255 / 0.02));
			}

			.footer-content {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-2xl);
				display: grid;
				grid-template-columns: 1fr 2fr;
				gap: var(--spacing-3xl);
			}

			.footer-logo {
				font-size: var(--font-size-lg);
				font-weight: var(--font-weight-display);
				letter-spacing: -0.03em;
			}

			.footer-logo .site-mark {
				width: 26px;
				height: 26px;
			}

			.footer-tagline {
				margin-top: var(--spacing-md);
				font-size: var(--font-size-sm);
				color: var(--color-muted);
			}

			.footer-links {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--spacing-xl);
			}

			.footer-col h4 {
				font-size: var(--font-size-xs);
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--color-faint);
				margin-bottom: var(--spacing-md);
			}

			.footer-col a {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				padding: var(--spacing-xs) 0;
				transition: color var(--transition-fast);
			}

			.footer-col a:hover {
				color: var(--color-text);
			}

			.footer-bottom {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-lg);
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: var(--spacing-md);
				font-size: var(--font-size-sm);
				color: var(--color-faint);
				border-top: 1px solid var(--color-border);
			}

			.footer-powered a {
				color: var(--color-muted);
				text-decoration: underline;
				text-underline-offset: 2px;
			}

			@media (max-width: 768px) {
				.nav-links {
					display: none;
				}

				.nav-actions {
					margin-left: auto;
				}

				.footer-content {
					grid-template-columns: 1fr;
					gap: var(--spacing-2xl);
				}

				.footer-links {
					grid-template-columns: repeat(2, 1fr);
				}

				.footer-bottom {
					flex-direction: column;
					text-align: center;
				}
			}
		</style>
	</body>
</html>
