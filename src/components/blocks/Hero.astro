---
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type HeroBlock = Extract<PageContentBlock, { _type: "marketing_hero" }>;
type Props = BlockComponentProps<HeroBlock>;

const { value } = Astro.props;
const { anchor_id, eyebrow, headline, subheadline, image, centered } = value;

const primaryCta =
	value.primary_cta_label && value.primary_cta_url
		? { label: value.primary_cta_label, url: sanitizeHref(value.primary_cta_url) }
		: undefined;
const secondaryCta =
	value.secondary_cta_label && value.secondary_cta_url
		? { label: value.secondary_cta_label, url: sanitizeHref(value.secondary_cta_url) }
		: undefined;
---

<section
	id={anchor_id || undefined}
	class:list={["hero", centered ? "hero-centered" : "hero-split"]}
>
	<div class="hero-inner">
		<div class="hero-content" data-reveal>
			{eyebrow && <p class="hero-eyebrow"><span class="dot" aria-hidden="true"></span>{eyebrow}</p>}
			<h1 class="hero-headline">{headline}</h1>
			{subheadline && <p class="hero-subheadline">{subheadline}</p>}
			{(primaryCta || secondaryCta) && (
				<div class="hero-actions">
					{primaryCta && (
						<a href={primaryCta.url} class="btn btn-primary btn-lg">
							{primaryCta.label}
							<span aria-hidden="true">→</span>
						</a>
					)}
					{secondaryCta && (
						<a href={secondaryCta.url} class="btn btn-secondary btn-lg">
							{secondaryCta.label}
						</a>
					)}
				</div>
			)}
		</div>
		{!centered && (
			<div class="hero-media" data-reveal style="--reveal-index: 2">
				<div class="hero-frame">
					{image ? (
						<Image image={image} class="hero-image-media" priority />
					) : (
						<img
							src="/hero-visual.svg"
							alt="A graph of people, places and events linked by their relationships"
							width="800"
							height="800"
						/>
					)}
				</div>
			</div>
		)}
	</div>
</section>

<style>
	.hero {
		padding: var(--spacing-3xl) var(--spacing-lg);
	}

	.hero-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	.hero-split .hero-inner {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: var(--spacing-3xl);
		align-items: center;
		min-height: min(78vh, 760px);
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
	}

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		align-self: flex-start;
		padding: 0.35rem 0.85rem;
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-muted);
		background: rgb(255 255 255 / 0.04);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-full);
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-event);
		box-shadow: 0 0 0 4px rgb(16 185 129 / 0.18);
	}

	.hero-headline {
		font-size: var(--font-size-5xl);
		font-weight: var(--font-weight-display);
		line-height: 1.02;
		letter-spacing: var(--tracking-tight);
		background: var(--gradient-headline);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		padding-bottom: 0.08em;
	}

	.hero-subheadline {
		max-width: 34rem;
		font-size: var(--font-size-xl);
		line-height: var(--leading-normal);
		color: var(--color-muted);
	}

	.hero-actions {
		display: flex;
		gap: var(--spacing-md);
		flex-wrap: wrap;
		margin-top: var(--spacing-sm);
	}

	.hero-media {
		position: relative;
	}

	.hero-media::before {
		content: "";
		position: absolute;
		inset: 8% 4%;
		background: var(--gradient-spectrum);
		filter: blur(70px);
		opacity: 0.28;
		z-index: -1;
	}

	.hero-frame {
		position: relative;
		overflow: hidden;
		border-radius: 28px;
		border: 1px solid var(--color-border-strong);
		background:
			radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.07) 1px, transparent 0) 0 0 / 22px
				22px,
			linear-gradient(180deg, rgb(22 25 32 / 0.9), rgb(10 11 14 / 0.95));
		box-shadow: var(--shadow-xl);
		animation: float 9s ease-in-out infinite;
	}

	.hero-frame img,
	.hero-frame :global(.hero-image-media) {
		width: 100%;
		height: auto;
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-10px);
		}
	}

	/* Centered: the closing call to action, drawn as a glowing panel. */
	.hero-centered {
		padding-block: var(--spacing-3xl);
	}

	.hero-centered .hero-inner {
		position: relative;
		max-width: 960px;
		padding: var(--spacing-3xl) var(--spacing-xl);
		text-align: center;
		border-radius: 32px;
		background:
			radial-gradient(40rem 20rem at 50% 0%, rgb(89 191 224 / 0.16), transparent 70%),
			radial-gradient(30rem 16rem at 50% 100%, rgb(223 76 149 / 0.14), transparent 70%),
			var(--color-surface);
		border: 1px solid var(--color-border-strong);
		overflow: hidden;
	}

	.hero-centered .hero-content {
		align-items: center;
	}

	.hero-centered .hero-eyebrow {
		align-self: center;
	}

	.hero-centered .hero-headline {
		font-size: var(--font-size-3xl);
		background: var(--gradient-spectrum);
		-webkit-background-clip: text;
		background-clip: text;
	}

	.hero-centered .hero-subheadline {
		font-size: var(--font-size-lg);
	}

	.hero-centered .hero-actions {
		justify-content: center;
	}

	@media (max-width: 960px) {
		.hero-split .hero-inner {
			grid-template-columns: 1fr;
			min-height: 0;
			gap: var(--spacing-2xl);
		}

		.hero-subheadline {
			font-size: var(--font-size-lg);
		}
	}

	@media (max-width: 600px) {
		.hero {
			padding: var(--spacing-xl) var(--spacing-md);
		}

		.hero-centered .hero-inner {
			padding: var(--spacing-2xl) var(--spacing-lg);
		}

		.hero-actions .btn {
			flex: 1 1 100%;
		}
	}
</style>
