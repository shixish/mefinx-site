---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type ConversationBlock = Extract<PageContentBlock, { _type: "marketing_conversation" }>;
type Props = BlockComponentProps<ConversationBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline, messages, caption } = value;
---

<section class="conversation section" id={anchor_id || undefined}>
	<div class="container">
		<header class="section-header">
			<h2 class="section-headline">{headline}</h2>
			{subheadline && <p class="section-subheadline">{subheadline}</p>}
		</header>
		<div class="chat" role="list">
			{messages.map((message) => (
				<div
					class:list={["bubble", message.speaker === "you" ? "bubble-you" : "bubble-mefinx"]}
					role="listitem"
				>
					<span class="speaker">{message.speaker === "you" ? "You" : "mefinx"}</span>
					<p>{message.text}</p>
				</div>
			))}
		</div>
		{caption && <p class="caption">{caption}</p>}
	</div>
</section>

<style>
	.conversation {
		background: var(--color-surface);
		border-block: 1px solid var(--color-border);
	}

	.chat {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.bubble {
		max-width: 80%;
		padding: var(--spacing-md) var(--spacing-lg);
		border-radius: var(--radius-lg);
		line-height: var(--leading-normal);
	}

	.speaker {
		display: block;
		margin-bottom: var(--spacing-xs);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		opacity: 0.75;
	}

	.bubble-you {
		align-self: flex-end;
		color: var(--color-on-brand);
		background: var(--gradient-brand-strong);
		border-bottom-right-radius: var(--radius-sm);
	}

	.bubble-mefinx {
		align-self: flex-start;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-bottom-left-radius: var(--radius-sm);
	}

	.bubble-mefinx .speaker {
		color: var(--color-brand);
		opacity: 1;
	}

	.caption {
		max-width: var(--max-width);
		margin: var(--spacing-2xl) auto 0;
		text-align: center;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	@media (max-width: 600px) {
		.bubble {
			max-width: 92%;
		}
	}
</style>
