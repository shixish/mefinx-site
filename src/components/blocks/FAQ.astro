---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type FAQBlock = Extract<PageContentBlock, { _type: "marketing_faq" }>;
type Props = BlockComponentProps<FAQBlock>;

const { value } = Astro.props;
const { anchor_id, headline, items } = value;
---

<section class="faq section" id={anchor_id || undefined}>
	<div class="container faq-layout">
		<header class="faq-header" data-reveal>
			<span class="section-eyebrow">FAQ</span>
			{headline && <h2 class="section-headline">{headline}</h2>}
		</header>
		<div class="faq-list" data-reveal style="--reveal-index: 1">
			{items.map((item) => (
				<details class="faq-item" name="faq">
					<summary class="faq-question">
						<span>{item.question}</span>
						<svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M12 5v14M5 12h14" />
						</svg>
					</summary>
					<div class="faq-answer">
						<p>{item.answer}</p>
					</div>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	.faq-layout {
		display: grid;
		grid-template-columns: 0.7fr 1.3fr;
		gap: var(--spacing-3xl);
		align-items: start;
	}

	.faq-header {
		position: sticky;
		top: 100px;
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--color-border);
	}

	.faq-item {
		border-bottom: 1px solid var(--color-border);
	}

	.faq-question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding: 1.25rem 0;
		font-size: var(--font-size-lg);
		font-weight: 600;
		letter-spacing: -0.01em;
		cursor: pointer;
		list-style: none;
		transition: color var(--transition-fast);
	}

	.faq-question:hover {
		color: var(--color-brand-soft);
	}

	.faq-question::-webkit-details-marker {
		display: none;
	}

	.faq-icon {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		color: var(--color-muted);
		transition: transform var(--transition-base), color var(--transition-base);
	}

	.faq-item[open] .faq-icon {
		transform: rotate(45deg);
		color: var(--color-accent);
	}

	.faq-answer {
		padding: 0 2.5rem 1.4rem 0;
	}

	.faq-answer p {
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
	}

	@media (max-width: 900px) {
		.faq-layout {
			grid-template-columns: 1fr;
			gap: var(--spacing-xl);
		}

		.faq-header {
			position: static;
		}

		.faq-question {
			font-size: var(--font-size-base);
		}
	}
</style>
