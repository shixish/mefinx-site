---
import { Icon } from "astro-iconset/components";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type FeaturesBlock = Extract<PageContentBlock, { _type: "marketing_features" }>;
type Props = BlockComponentProps<FeaturesBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline, features } = value;

const iconMap: Record<string, string> = {
	chat: "ph:chat-circle-dots",
	graph: "ph:graph",
	filter: "ph:funnel",
	search: "ph:magnifying-glass",
	pin: "ph:map-pin",
	calendar: "ph:calendar-dots",
	offline: "ph:wifi-slash",
	undo: "ph:arrow-counter-clockwise",
	lock: "ph:lock-key",
	sparkle: "ph:sparkle",
	phone: "ph:device-mobile",
	contacts: "ph:address-book",
	users: "ph:users-three",
	heart: "ph:heart",
	clock: "ph:clock",
	star: "ph:star",
};

// Icon tiles cycle through the brand and graph colours so the grid doesn't read as one block.
const tints = ["#59bfe0", "#df4c95", "#fad34a", "#3b82f6", "#10b981", "#a78bfa"];
---


<section class="features section" id={anchor_id || undefined}>
	<div class="container">
		{(headline || subheadline) && (
			<header class="section-header" data-reveal>
				<span class="section-eyebrow">What it does</span>
				{headline && <h2 class="section-headline">{headline}</h2>}
				{subheadline && <p class="section-subheadline">{subheadline}</p>}
			</header>
		)}
		<div class="features-grid">
			{features.map((feature, index) => (
				<div
					class="feature-card"
					data-reveal
					style={`--tint: ${tints[index % tints.length]}; --reveal-index: ${index % 3}`}
				>
					<div class="icon-tile feature-icon">
						<Icon name={iconMap[feature.icon] || "ph:sparkle"} aria-hidden="true" />
					</div>
					<h3 class="feature-title">{feature.title}</h3>
					<p class="feature-description">{feature.description}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.features-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-lg);
	}

	.feature-card {
		position: relative;
		padding: var(--spacing-xl);
		background: linear-gradient(180deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.01));
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition:
			border-color var(--transition-base),
			transform var(--transition-base),
			opacity 600ms ease;
	}

	.feature-card::before {
		content: "";
		position: absolute;
		inset: -40% -40% auto auto;
		width: 70%;
		aspect-ratio: 1;
		background: radial-gradient(circle, color-mix(in srgb, var(--tint) 30%, transparent), transparent 65%);
		opacity: 0;
		transition: opacity var(--transition-slow);
		pointer-events: none;
	}

	.feature-card:hover {
		border-color: color-mix(in srgb, var(--tint) 45%, transparent);
	}

	.feature-card:hover::before {
		opacity: 1;
	}

	.feature-icon {
		margin-bottom: var(--spacing-lg);
		color: var(--tint);
		background: color-mix(in srgb, var(--tint) 14%, transparent);
		border: 1px solid color-mix(in srgb, var(--tint) 30%, transparent);
	}

	.feature-title {
		font-size: var(--font-size-lg);
		font-weight: 700;
		letter-spacing: -0.015em;
		margin-bottom: var(--spacing-sm);
	}

	.feature-description {
		font-size: 0.95rem;
		color: var(--color-muted);
		line-height: var(--leading-normal);
	}

	@media (max-width: 900px) {
		.features-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.features-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
