{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mefinx-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Served only on mefinx.com (www redirects there, see src/worker.ts). The workers.dev and
	// preview URLs are off so the admin can't be reached on a host its passkey doesn't match.
	"routes": [
		{ "pattern": "mefinx.com", "custom_domain": true },
		{ "pattern": "www.mefinx.com", "custom_domain": true },
	],
	"workers_dev": false,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mefinx-site",
		},
	],
	// Astro's session store. wrangler created this namespace on an earlier deploy but can't find it
	// again by name (it only reuses bindings from a Worker that deployed), so it is pinned by id.
	// A namespace id is not a secret: it does nothing without an API token for the account.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "5a3c93676a6c4fbda36732b2d14d3d74",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "mefinx-site-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
